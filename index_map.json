[{"i": 0, "cat": "인사", "text": "안녕하세요, 만나서 반갑습니다.", "voices": ["f", "m"]}, {"i": 1, "cat": "인사", "text": "식사하셨어요?", "voices": ["f", "m"]}, {"i": 2, "cat": "인사", "text": "오늘 날씨가 정말 좋네요.", "voices": ["f", "m"]}, {"i": 3, "cat": "인사", "text": "잠깐만 기다려 주세요.", "voices": ["f", "m"]}, {"i": 4, "cat": "일상", "text": "지금 뭐 하고 있어?", "voices": ["f", "m"]}, {"i": 5, "cat": "일상", "text": "밥 먹었어?", "voices": ["f", "m"]}, {"i": 6, "cat": "일상", "text": "왜 그래? 무슨 일 있어?", "voices": ["f", "m"]}, {"i": 7, "cat": "일상", "text": "너무 많이 아파서 병원에 가야 돼.", "voices": ["f", "m"]}, {"i": 8, "cat": "카페·식당", "text": "아이스 아메리카노 한 잔 주세요.", "voices": ["f", "m"]}, {"i": 9, "cat": "카페·식당", "text": "여기 물 좀 더 주실 수 있어요?", "voices": ["f", "m"]}, {"i": 10, "cat": "카페·식당", "text": "계산은 카드로 할게요.", "voices": ["f", "m"]}, {"i": 11, "cat": "카페·식당", "text": "이거 포장해 주세요.", "voices": ["f", "m"]}, {"i": 12, "cat": "직장", "text": "회의 자료는 내일까지 보내 드리겠습니다.", "voices": ["f", "m"]}, {"i": 13, "cat": "직장", "text": "죄송하지만 다시 한번 말씀해 주시겠어요?", "voices": ["f", "m"]}, {"i": 14, "cat": "직장", "text": "확인하고 바로 연락드리겠습니다.", "voices": ["f", "m"]}, {"i": 15, "cat": "발음 훈련", "text": "으슥한 음식점에서 은행 직원을 만났어요.", "voices": ["f", "m"]}, {"i": 16, "cat": "발음 훈련", "text": "쌀 한 되와 살 한 근을 샀어요.", "voices": ["f", "m"]}, {"i": 17, "cat": "발음 훈련", "text": "간장 공장 공장장은 강 공장장이고 된장 공장 공장장은 공 공장장이다.", "voices": ["f", "m"]}]